# Copy this file to .env and adjust as needed. Never commit .env.

# Shown in the top bar.
CLINIC_NAME=Demo Specialist Clinic

# SQLite file. Leave blank to use backend/clinic.db.
DATABASE_URL=

# Origin of the Next.js frontend, allowed through CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Optional: natural-language booking. Leave the key blank to hide the feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
